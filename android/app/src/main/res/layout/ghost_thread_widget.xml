<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ghost_thread_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ghost_thread_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/ghost_thread_widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="@string/ghost_thread_widget_label"
        android:textAllCaps="true"
        android:textColor="#FFD0BCFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/ghost_thread_widget_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:text="@string/ghost_thread_widget_empty"
        android:textColor="#FFF3EDF7"
        android:textSize="14sp" />

</LinearLayout>
